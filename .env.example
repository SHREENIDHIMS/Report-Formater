# Local development only. Replace placeholders; never commit real secrets.
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://vtu:local-dev-only@localhost:5432/vtu_report_studio
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_BYTES=52428800
MAX_DOCX_UNCOMPRESSED_BYTES=262144000
MAX_DOCX_ZIP_ENTRIES=5000
AUTH_DISABLED=true

# Private storage: local in development. Production should use a private S3-compatible bucket.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./private-storage
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# Auth provider placeholders (server-side verification only)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Payments provider placeholders (never expose secret in browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
